{
  "expo": {
    "name": "Central de Chamados",
    "slug": "central-chamados",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "central-chamados",
    "android": {
      "package": "com.centralchamados.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d1117"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1117"
        }
      ]
    ]
  }
}
