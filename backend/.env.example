# Conexão usada pelo Prisma Client (pooler de transação do Supabase).
# Substitua os valores pelos dados exibidos em Supabase > Connect.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true"

# Conexão usada pelo Prisma Migrate.
# Prefira a conexão direta (porta 5432); em redes IPv4-only, use o Session Pooler (porta 5432).
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

JWT_SECRET="troque-por-uma-string-aleatoria-longa"
PORT=3333
# Origens web locais: Vite e Expo web. Separe origens adicionais por vírgula.
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
